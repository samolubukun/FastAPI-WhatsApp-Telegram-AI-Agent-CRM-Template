# .env.example

# Environment setting. Options: "production"|"development"
ENVIRONMENT="development"

# WhatsApp / Meta Credentials
VERIFY_TOKEN="your_secret_verify_token"
WHATSAPP_TOKEN="your_whatsapp_cloud_api_token"
PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_API_VERSION="v22.0"

# Database Configuration (Neon PostgreSQL or fallback SQLite)
DATABASE_URL="sqlite+aiosqlite:///./whatsapp_agent.db"
# DATABASE_URL="postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Memory History Limit
MEMORY_HISTORY_LIMIT=30

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL_NAME="gpt-4o-mini"

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"
TELEGRAM_WEBHOOK_SECRET="your_secure_telegram_webhook_secret"

# Security for internal APIs (e.g., called by n8n or external services)
INTERNAL_API_KEY="your_super_secret_and_random_api_key_here"
